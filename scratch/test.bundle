          var priceA = a.minimum_price || a.puja_with_samagri_amount || 0;
          var priceB = b.minimum_price || b.puja_with_samagri_amount || 0;
          return priceA - priceB;
        });
      } else if (sortBy === 'priceHigh') {
        sorted.sort((a, b) => {
          var priceA = a.minimum_price || a.puja_with_samagri_amount || 0;
          var priceB = b.minimum_price || b.puja_with_samagri_amount || 0;
          return priceB - priceA;
        });
      } else if (sortBy === 'rating') {
        sorted.sort((a, b) => {
          var ratingA = a.puja_rating || 5;
          var ratingB = b.puja_rating || 5;
          return ratingB - ratingA;
        });
      } else if (sortBy === 'nameAsc') {
        sorted.sort((a, b) => {
          var nameA = (a.puja_name || a.puja_type_name || '').toLowerCase();
          var nameB = (b.puja_name || b.puja_type_name || '').toLowerCase();
